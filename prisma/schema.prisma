// Prisma schema — Aviation Incident Investigation Assistant
//
// Phase 2 (Database) scope only: User, Investigation, InvestigationHistory,
// LoginAttempt, and the Auth.js adapter tables (Account, Session,
// VerificationToken). Every other entity in data-model.md §3 is added in the
// phase that first needs it, per implementation-plan.md's incremental-schema
// approach — this keeps each phase independently verifiable.
//
// Source of truth: data-model.md §3.1 (User), §3.2 (Investigation),
// §3.24 (InvestigationHistory); LoginAttempt is new, added to close
// spec-review.md SR-010. technical-architecture.md §5.2 explains why native
// Postgres enums are used here in place of data-model.md's CHECK-constrained
// VARCHAR convention (DM-5) — an explicitly documented, safe upgrade path.

// Prisma 7 requires an explicit generator output path and configures the
// connection via prisma.config.ts + a driver adapter rather than a
// datasource.url/directUrl field (both removed in v7). See
// technical-architecture.md §5.2's addendum for why this differs from the
// datasource-block pattern that document originally illustrated — the
// environment variables and Neon/pooling architecture are unchanged, only
// the file that wires them up is different.
generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Enumerations -----------------------------------------------------

enum UserRole {
  Administrator
  InvestigationManager
  Investigator
  Reviewer
  Viewer
}

enum InvestigationStatus {
  Draft
  Open
  UnderInvestigation
  Analysis
  Review
  Closed
}

enum HistoryEventType {
  Created
  InvestigatorAssigned
  InvestigatorReassigned
  StageAdvanced
  SubmittedForReview
  ReviewApproved
  ReviewChangesRequested
  Reopened
  Closed
  DraftDeleted
}

enum LoginAttemptType {
  Login
  Upload
}

// --- Phase 5 enumerations (data-model.md §2.3-§2.7, §5, §6) --------------

enum PhaseOfFlight {
  Standing
  Taxi
  Takeoff
  InitialClimb
  Climb
  Cruise
  Descent
  Approach
  Landing
  GoAround
  PostLandingTaxi
}

// data-model.md §6.6 — 14-value occurrence classification taxonomy.
// Regulator-neutrality disclaimer: product-spec.md §11.4.
enum OccurrenceCategory {
  AircraftIncident
  GroundHandlingIncident
  RampSafetyIncident
  BaggageIncident
  CargoIncident
  DangerousGoodsIncident
  PassengerHandlingIncident
  SecurityRelatedOccurrence
  OccupationalSafetyIncident
  EquipmentVehicleIncident
  MaintenanceRelatedOccurrence
  EnvironmentalOccurrence
  NearMiss
  Other
}

// data-model.md §5 — shared severity vocabulary (Hazard, Occurrence outcomes).
// Corrected per spec-review.md SR-004: `Hazardous` replaced by `Moderate`.
enum RiskSeverity {
  Negligible
  Minor
  Moderate
  Major
  Catastrophic
}

enum RiskLikelihood {
  Rare
  Unlikely
  Possible
  Likely
  AlmostCertain
}

enum InvestigationPriority {
  Routine
  Elevated
  Urgent
  Immediate
}

enum DamageLevel {
  None
  Minor
  Substantial
  Destroyed
}

enum InjuryLevel {
  None
  Minor
  Serious
  Fatal
}

enum FlightRules {
  VFR
  IFR
}

enum PersonRoleType {
  PIC
  FirstOfficer
  CabinCrew
  ATC
  GroundStaff
  Maintenance
  Passenger
  Other
}

enum ImmediateActionType {
  Safety
  Operational
  Notification
}

// data-model.md §5 — WitnessType
enum WitnessType {
  Crew
  Passenger
  ATC
  GroundObserver
  Other
}

// data-model.md §5 — EvidenceType (10-category taxonomy)
enum EvidenceType {
  Photographs
  Documents
  Statements
  CCTVReference
  FlightRecords
  MaintenanceRecords
  GroundHandlingRecords
  TrainingRecords
  Emails
  Other
}

// data-model.md §5 — shared High/Medium/Low value set, used for both
// Witness/Evidence "reliability" (trustworthiness) and Evidence
// "relevance" (how pertinent) — conceptually distinct fields, same scale.
enum AssessmentLevel {
  High
  Medium
  Low
}

// --- Core entities ------------------------------------------------------

// data-model.md §3.1
model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(150)
  email        String   @unique @db.VarChar(254)
  passwordHash String   @db.VarChar(255)
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  createdInvestigations  Investigation[]        @relation("InvestigationCreatedBy")
  assignedInvestigations Investigation[]        @relation("InvestigationAssignedTo")
  historyEntries         InvestigationHistory[]
  loginAttempts          LoginAttempt[]
  accounts               Account[]
  sessions               Session[]
  classifiedOccurrences  Occurrence[]
  uploadedAttachments    Attachment[]

  @@index([role])
}

// data-model.md §3.2 (was `Incident`)
model Investigation {
  id                         Int                 @id @default(autoincrement())
  referenceNumber            String              @unique @db.VarChar(20)
  title                      String              @db.VarChar(200)
  status                     InvestigationStatus @default(Draft)
  reporterName               String              @db.VarChar(150)
  createdByUserId            Int
  assignedInvestigatorUserId Int?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  closedAt                   DateTime?
  reopenReason               String?

  createdBy            User                   @relation("InvestigationCreatedBy", fields: [createdByUserId], references: [id])
  assignedInvestigator User?                  @relation("InvestigationAssignedTo", fields: [assignedInvestigatorUserId], references: [id])
  historyEntries       InvestigationHistory[]
  occurrence           Occurrence?
  aircraft             Aircraft?
  flight               Flight?
  location             Location?
  persons              Person[]
  immediateActions     ImmediateAction[]
  witnesses            Witness[]
  evidence             Evidence[]

  @@index([status])
  @@index([assignedInvestigatorUserId])
  @@index([createdByUserId])
}

// data-model.md §3.3. The Phase 4 addendum created this table early with
// only investigationId/occurrenceDateUtc (FR-005's own dependency on it);
// this phase's migration ALTERs it to add every remaining field.
model Occurrence {
  investigationId Int @id

  occurrenceDateUtc    DateTime
  occurrenceTimeUtc    DateTime?      @db.Time
  occurrenceTimeLocal  DateTime?      @db.Time
  phaseOfFlight        PhaseOfFlight?
  briefDescription     String?        @db.VarChar(240)
  narrativeDescription String?        @db.Text

  occurrenceCategory            OccurrenceCategory?
  occurrenceSubcategoryId       Int?
  actualOutcomeSeverity         RiskSeverity?
  actualOutcomeDescription      String?                @db.Text
  potentialOutcomeSeverity      RiskSeverity?
  potentialOutcomeDescription   String?                @db.Text
  likelihoodOfRecurrence        RiskLikelihood?
  severity                      RiskSeverity?
  severityOverridden            Boolean                @default(false)
  severityOverrideJustification String?                @db.Text
  riskScore                     Int?
  riskBand                      String?                @db.VarChar(20)
  investigationPriority         InvestigationPriority?
  priorityOverridden            Boolean                @default(false)
  priorityOverrideJustification String?                @db.Text
  suggestedCategory             OccurrenceCategory?
  suggestedSubcategoryId        Int?
  wasSuggestionAccepted         Boolean?
  classifiedByUserId            Int?
  classifiedAt                  DateTime?

  noPersonsInvolvedConfirmed   Boolean @default(false)
  noWitnessesConfirmed         Boolean @default(false)
  noEvidenceAvailableConfirmed Boolean @default(false)

  investigation         Investigation                @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  occurrenceSubcategory OccurrenceSubcategoryOption? @relation("OccurrenceSubcategory", fields: [occurrenceSubcategoryId], references: [id])
  suggestedSubcategory  OccurrenceSubcategoryOption? @relation("OccurrenceSuggestedSubcategory", fields: [suggestedSubcategoryId], references: [id], onDelete: SetNull)
  classifiedBy          User?                        @relation(fields: [classifiedByUserId], references: [id])

  @@index([occurrenceCategory])
  @@index([riskBand])
}

// data-model.md §3.3.1 — controlled-vocabulary lookup, seeded at deploy
// time (data-model.md §6.6). Not user-editable through any FR.
model OccurrenceSubcategoryOption {
  id           Int                @id @default(autoincrement())
  category     OccurrenceCategory
  subcategory  String             @db.VarChar(80)
  displayOrder Int                @default(0)
  isActive     Boolean            @default(true)

  classifiedOccurrences  Occurrence[] @relation("OccurrenceSubcategory")
  suggestedOnOccurrences Occurrence[] @relation("OccurrenceSuggestedSubcategory")

  @@unique([category, subcategory])
  @@index([category])
}

// data-model.md §3.4
model Aircraft {
  investigationId   Int         @id
  registration      String      @db.VarChar(20)
  manufacturer      String      @db.VarChar(100)
  model             String      @db.VarChar(100)
  serialNumber      String?     @db.VarChar(50)
  yearOfManufacture Int?
  operatorName      String      @db.VarChar(150)
  engineType        String?     @db.VarChar(100)
  engineCount       Int         @default(1)
  damageLevel       DamageLevel @default(None)

  investigation Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
}

// data-model.md §3.5
model Flight {
  investigationId      Int         @id
  flightNumber         String?     @db.VarChar(20)
  flightRules          FlightRules
  departureAerodrome   String      @db.VarChar(100)
  destinationAerodrome String      @db.VarChar(100)
  alternateAerodrome   String?     @db.VarChar(100)
  picName              String      @db.VarChar(150)
  picLicenseNumber     String?     @db.VarChar(50)
  crewComplement       Int         @default(1)

  investigation Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
}

// data-model.md §3.6
model Location {
  investigationId     Int      @id
  locationDescription String   @db.Text
  latitude            Decimal? @db.Decimal(9, 6)
  longitude           Decimal? @db.Decimal(9, 6)
  aerodromeCode       String?  @db.VarChar(10)
  weatherVisibility   String?  @db.VarChar(50)
  windSpeedKt         Int?
  windDirectionDeg    Int?
  cloudCover          String?  @db.VarChar(50)
  temperatureC        Int?
  precipitation       String?  @db.VarChar(50)
  runwayInUse         String?  @db.VarChar(20)
  lightingConditions  String   @db.VarChar(10)
  terrainType         String?  @db.VarChar(50)

  investigation Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
}

// data-model.md §3.7
model Person {
  id              Int            @id @default(autoincrement())
  investigationId Int
  name            String         @db.VarChar(150)
  roleType        PersonRoleType
  licenseNumber   String?        @db.VarChar(50)
  nationality     String?        @db.VarChar(60)
  injuryLevel     InjuryLevel    @default(None)
  notes           String?        @db.Text

  investigation Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  @@index([investigationId])
}

// data-model.md §3.11
model ImmediateAction {
  id              Int                 @id @default(autoincrement())
  investigationId Int
  description     String              @db.Text
  takenBy         String              @db.VarChar(150)
  occurredAt      DateTime
  actionType      ImmediateActionType

  investigation Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  @@index([investigationId])
}

// data-model.md §3.8
model Witness {
  id                    Int             @id @default(autoincrement())
  investigationId       Int
  name                  String          @db.VarChar(150)
  contactInfo           String?         @db.VarChar(200)
  witnessType           WitnessType
  statementSummary      String          @db.Text
  statementDate         DateTime?       @db.Date
  reliabilityAssessment AssessmentLevel
  reliabilityNotes      String?         @db.Text

  investigation Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  @@index([investigationId])
}

// data-model.md §3.9
model Evidence {
  id                    Int             @id @default(autoincrement())
  investigationId       Int
  evidenceType          EvidenceType
  description           String          @db.Text
  source                String          @db.VarChar(200)
  collectedBy           String?         @db.VarChar(150)
  dateObtained          DateTime?       @db.Date
  relevance             AssessmentLevel
  reliabilityAssessment AssessmentLevel
  reliabilityNotes      String?         @db.Text
  investigatorNotes     String?         @db.Text
  custodyNotes          String?         @db.Text

  investigation Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  attachments   Attachment[]

  @@index([investigationId])
  @@index([evidenceType])
  @@index([relevance])
}

// data-model.md §3.10, corrected per technical-architecture.md §9 / TA-1
// and spec-review.md SR-001/SR-002: attachment bytes live in `fileBytes`
// (Postgres `bytea`), not on disk — Vercel's serverless filesystem cannot
// durably persist an upload across invocations. `storagePath` is kept as
// the StorageProvider interface's opaque handle (a generated key, not a
// filesystem path) so a future object-storage-backed provider is a
// swap-in change, not a rewrite.
model Attachment {
  id               Int      @id @default(autoincrement())
  evidenceId       Int
  fileName         String   @db.VarChar(255)
  mimeType         String   @db.VarChar(100)
  fileSizeBytes    Int
  storagePath      String   @unique @db.VarChar(500)
  fileBytes        Bytes
  isSimulated      Boolean  @default(false)
  uploadedByUserId Int
  uploadedAt       DateTime @default(now())

  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedByUserId], references: [id])

  @@index([evidenceId])
}

// data-model.md §6.4 — configurable risk-band matrix. Seeded with the
// default Low/Moderate/High/Critical bands; Administrator edit UI is
// Phase 7's FR-069, not this phase's — this phase only reads it.
model RiskBandConfiguration {
  id           Int     @id @default(autoincrement())
  minScore     Int
  maxScore     Int
  bandLabel    String  @db.VarChar(20)
  colorHint    String? @db.VarChar(20)
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  @@index([minScore, maxScore])
}

// New this phase — backs the per-year reference-number sequence
// (data-model.md §3.2's DM-16 addendum, closing spec-review.md SR-013).
model ReferenceNumberSequence {
  year      Int @id
  nextValue Int @default(1)
}

// data-model.md §3.24 — append-only audit log.
// `relatedReviewId` (FK -> InvestigationReview) is deferred to Phase 10,
// when InvestigationReview is introduced; adding it now would require a
// relation to a model that does not yet exist in this phase's schema.
model InvestigationHistory {
  id                Int                  @id @default(autoincrement())
  investigationId   Int
  eventType         HistoryEventType
  fromStatus        InvestigationStatus?
  toStatus          InvestigationStatus?
  performedByUserId Int
  reasonText        String?
  occurredAt        DateTime             @default(now())

  investigation Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  performedBy   User          @relation(fields: [performedByUserId], references: [id])

  @@index([investigationId, occurredAt])
}

// New this phase — closes spec-review.md SR-010 ("LoginAttempt referenced
// by technical-architecture.md §8 and security-spec.md §14 but never
// modeled"). Covers both rate-limiting use cases security-spec.md §14
// describes (login attempts and upload attempts) via `attemptType`.
model LoginAttempt {
  id          Int              @id @default(autoincrement())
  identifier  String           @db.VarChar(254) // email (Login) or a stable per-user key (Upload)
  ipAddress   String?          @db.VarChar(45) // IPv6-safe length
  attemptType LoginAttemptType
  succeeded   Boolean
  userId      Int?
  attemptedAt DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([identifier, attemptedAt])
  @@index([ipAddress, attemptedAt])
}

// --- Auth.js adapter tables (technical-architecture.md §4.4) ------------
//
// Standard @auth/prisma-adapter shape, adapted so the `userId` foreign keys
// match User.id's Int type from data-model.md §3.1 rather than the
// adapter's usual String-cuid default. Account/Session/VerificationToken
// are not entities data-model.md defines — they are infrastructure this
// phase adds because technical-architecture.md §4.4 requires database
// sessions via the Prisma adapter.

model Account {
  id                String  @id @default(cuid())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
