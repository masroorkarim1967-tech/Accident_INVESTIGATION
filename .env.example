# Environment variables — Aviation Incident Investigation Assistant
# See technical-architecture.md §11 and security-spec.md §8.
#
# This file lists every variable the application needs and nothing more —
# a direct, checkable confirmation that no AI provider key, paid third-party
# API key, or other external service credential is required to run it.
#
# Never put a real value in this file. Copy it to .env.local (git-ignored)
# and fill in real values there for local development.

# Pooled Neon Postgres connection string — used for runtime queries.
DATABASE_URL=

# Unpooled Neon Postgres connection string — used only by Prisma Migrate.
DIRECT_URL=

# Auth.js session/token signing secret.
# Generate with: npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_SECRET=

# Canonical app URL required by Auth.js (e.g. http://localhost:3000 locally).
NEXTAUTH_URL=

# Standard Node/Next.js environment flag.
NODE_ENV=development
